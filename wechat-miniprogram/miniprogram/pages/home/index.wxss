.home-page {
  min-height: 100vh;
  padding: 28rpx 26rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 34rpx 34rpx;
  border-radius: 30rpx;
  color: #fff;
  background: linear-gradient(140deg, #0c493c 0%, #12624f 58%, #1a8068 100%);
  box-shadow: 0 18rpx 50rpx rgba(18, 98, 79, .20);
}

.hero::after {
  position: absolute;
  top: -160rpx;
  right: -130rpx;
  width: 360rpx;
  height: 360rpx;
  border: 2rpx solid rgba(255, 255, 255, .13);
  border-radius: 50%;
  content: '';
}

.brand-mark {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, .24);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .12);
  font-size: 40rpx;
  font-weight: 800;
}

.hero-copy,
.network,
.primary-entry {
  position: relative;
  z-index: 1;
}

.hero-copy {
  display: flex;
  flex-direction: column;
}

.eyebrow {
  color: #a9dfd1;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.25;
}

.subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, .76);
  font-size: 25rpx;
  line-height: 1.65;
}

.network {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, .78);
  font-size: 22rpx;
}

.network-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #70e2b4;
  box-shadow: 0 0 0 8rpx rgba(112, 226, 180, .12);
}

.network.offline .network-dot {
  background: #ffbc69;
  box-shadow: 0 0 0 8rpx rgba(255, 188, 105, .12);
}

.primary-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  margin-top: 30rpx;
  border-radius: 20rpx;
  color: #115746;
  background: #fff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 42rpx 4rpx 20rpx;
}

.section-title {
  color: #183f35;
  font-size: 32rpx;
  font-weight: 800;
}

.section-tip {
  color: #7b8e89;
  font-size: 22rpx;
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.module-card {
  display: flex;
  align-items: flex-start;
  min-height: 176rpx;
  margin: 0;
  padding: 24rpx 22rpx;
  border: 2rpx solid #e0eae7;
  border-radius: 24rpx;
  color: #173b32;
  background: #fff;
  text-align: left;
  line-height: 1.4;
  box-shadow: 0 8rpx 24rpx rgba(28, 70, 59, .045);
}

.module-card-active {
  border-color: #a7cfc3;
  background: #edf7f3;
  transform: scale(.985);
}

.module-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  color: #12624f;
  background: #e8f5f0;
  font-size: 28rpx;
  font-weight: 800;
}

.module-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.module-title {
  font-size: 28rpx;
  font-weight: 750;
}

.module-description {
  margin-top: 8rpx;
  color: #70837e;
  font-size: 21rpx;
  line-height: 1.5;
}

.notice {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  color: #667c76;
  background: #eaf2ef;
  font-size: 22rpx;
  line-height: 1.65;
}

.notice-title {
  color: #315c51;
  font-weight: 700;
}
